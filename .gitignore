# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-lock.yaml

# testing
/coverage
/.playwright-mcp
/playwright-report/
/test-results/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# uploads
public/uploads

# pdfjs worker — generated by scripts/copy-pdfjs-worker.mjs (postinstall)
public/pdf.worker.min.mjs

# LiteRT-LM WASM — gekopieerd uit node_modules door scripts/copy-litert-wasm.mjs
# (predev/prebuild); self-hosted zodat de lokale AI-runtime NIET van jsdelivr laadt.
public/litert-wasm/

# service worker — generated door `serwist build` (zie serwist.config.mjs).
# Niet tracken: een prod-build SW in een fresh checkout wordt door `next dev`
# geserveerd en onderschept dan alle /api/*-requests, met "Failed to fetch"
# tijdens HMR tot gevolg.
public/sw.js

nul
.playwright-cli/
.playwright/

# auth state (contains tokens)
auth-state.json
auth_result.json
auth.json

# Claude Code harness-local state — never commit
.claude/scheduled_tasks.lock
.claude/worktrees/
.claude/fix-mojibake.ps1

# research artifacts
signin2.yaml

# local debug screenshots / scratch
.tmp/

# dev-/test-server logs in de projectroot (nooit committen)
/server-*.log
/dev-server*.log
# root screenshot- / regressietest-artefacten (alleen root; public/ + docs/ blijven getrackt)
/*.png
/claude-progress.txt

# eenmalige gegenereerde rapporten/presentaties in de projectroot (alleen root;
# public/ + docs/ blijven getrackt). Deze glipten er eerder in via `git add -A`:
# het UX-onderzoek stond met 8,2 MB in de historie -- 9,3 MB daarvan base64-
# schermafbeeldingen -- terwijl niets ernaar verwees. Wil je zo'n rapport
# bewaren, zet 'm dan in docs/ of publiceer 'm als artifact; de root is een
# werkplek, geen archief.
/*.html
# uitzondering: hier wordt wel naar verwezen (competitive-brief-skill + docs/zoekvragen.md)
!/trifinity-positionering-onderzoek-sep2026.html

# ad-hoc importfixtures/probes in de projectroot (echte fixtures horen in test/)
/test-*.csv
/test-*.txt
# curl cookie-jars
cookies*.txt

# superpowers brainstorm visual-companion working dir (generated)
.superpowers/

# autoforge spec-tooling working dir (lokale assistent-settings/prompts) — nooit committen
.autoforge/

# ad-hoc root debug/probe scripts (login/signup probes, port killers, one-off
# migration runners) — never commit; these have leaked service-role keys before.
/.*.mjs

# python bytecode (horizon-oracle extractor)
__pycache__/

# Persoonlijke Claude-permissies — nooit committen
.claude/settings.local.json

# Uitvoer van de herstelproef-controle (scripts/herstelproef-check.mjs) — tellingen
# en hashes van een specifiek moment; hoort in het runbook, niet in de repo.
nulmeting*.json
herstelproef-*.json
