#!/usr/bin/env sh

# Pre-push: TypeScript-check op productie-code (test-files exclude).
#
# Eerder draaiden we `npx next build` lokaal als pre-push check, maar dat
# vereist netwerk-toegang (Google Fonts download) en faalt in beperkte
# containers. Snellere en robuuste check: `tsc --noEmit` op alleen
# productie-code — Vercel's build pakt de full check op bij ontvangst.
#
# Test-files (.test.*, /test/, /__tests__/) hebben pre-existing strict-type
# issues die geen build-blocker zijn (Vercel skipt ze). Hier filteren we
# die uit zodat het hook-resultaat de echte productie-status reflecteert.

set -e

echo "→ Running tsc --noEmit on production code…"

# Capture output, filter test-file errors, fail als er productie-errors zijn
output=$(npx tsc --noEmit 2>&1 || true)
# Filter test-file errors (pre-existing strict-type issues, Vercel skipt ze)
# en .next/types errors (gegenereerde route-validators raken stale bij
# folder-renames; Vercel regenereert ze bij elke build).
production_errors=$(echo "$output" | grep "error TS" | grep -v "\.test\.\|/test/\|/__tests__/\|\.next/" || true)

if [ -n "$production_errors" ]; then
  echo ""
  echo "✗ TypeScript errors in production code:"
  echo ""
  echo "$production_errors"
  echo ""
  echo "Fix these before pushing. Test-file errors are skipped (pre-existing)."
  exit 1
fi

echo "✓ TypeScript check passed (production code clean)."

# Datapad-conventie (ADR 0058): flag NIEUWE directe client-reads voor
# weergavedata buiten de grandfather-allowlist. De bestaande ~47 lezers
# staan op de allowlist; alleen nieuwe overtredingen blokkeren de push.
echo "→ Running datapad-conventie check (ADR 0058)…"
node scripts/check-client-data-reads.mjs

# Vrijheidstijd-grondslag (KRUIS-20 + vervolg): het €→tijd-dagtarief komt uit
# ÉÉN bron (12-mnd rolling, lib/expense-rate.ts). Deze gate flagt een nieuw
# zelfgerekend dagtarief buiten de canonieke bron/allowlist. Twee keer op rij is
# precies deze drift ontstaan; de compiler ziet 'm niet (alles is `number`).
echo "→ Running vrijheidstijd-grondslag check (KRUIS-20)…"
node scripts/check-freedom-time-basis.mjs

# ShellOverlay-driewegregel (ADR 0039): flag een NIEUWE directe <BottomSheet>,
# een handgerolde `fixed inset-0`-overlay, of een scrim met een rauwe kleur
# i.p.v. var(--scrim). De regel stond al in CLAUDE.md maar had geen gate — met
# als resultaat 64 directe consumers en zeven verschillende scrims.
echo "→ Running ShellOverlay-driewegregel check (ADR 0039)…"
node scripts/check-overlay-standard.mjs

# Raakdrempel (M19): flag een NIEUWE icoonknop die zijn doos onder 44×44 vastzet
# zonder aantoonbaar raakgebied (touch-target / min-h-[44px] / TapTarget). Het
# UX-testpanel vond vier verschillende ad-hoc maten voor hetzelfde probleem;
# de norm stond al in de ui-ux-skill maar had geen gate.
echo "→ Running raakdrempel-check (M19)…"
node scripts/check-tap-targets.mjs

# Koppencontract (M28 / ADR 0110): binnen de app-shell draagt de shell de enige
# <h1> (de sr-only paginanaam); pagina-aanheffen zijn <h2>. Deze gate flagt een
# NIEUWE <h1> in app/(app)/** of components/**, en elke `level="h1"`. Het
# UX-testpanel mat twee h1's per pagina — dat kwam uit één gedeelde bouwsteen
# die op 30 call-sites gekopieerd was.
echo "→ Running koppencontract-check (M28)…"
node scripts/check-heading-levels.mjs

# Productiecijfers (ADR 0111): deze repo is PUBLIEK, en migratiecommentaar en ADR's
# zijn precies waar we ons huiswerk opschrijven — "gemeten op remote, N rijen",
# "op het eigenaar-account: €N". De sweep vond gegevens op recordniveau, het
# gebruikersaantal, en een e-mailadres pal naast een vermogenscijfer. De vorige
# opruiming was een afspraak en hield het zeven minuten vol; daarom een gate.
echo "→ Running productiecijfer-check (ADR 0111)…"
node scripts/check-productiecijfers.mjs

# Lokale-prompt-parity (ADR 0062): de gecondenseerde on-device DNA's zijn een
# AFGELEIDE van lib/ai/dna/base.ts + wil.ts. Wijzigt de bron zonder hercondensatie,
# dan praat de lokale Fin anders dan de cloud-Fin. Deze poort bestond al als
# commando maar hing aan NIETS — CI draait alleen arch:check. Hard, want er is een
# uitvoerbare herstelactie (skill: lokale-prompt-parity → `npm run parity:scan`).
echo "→ Running lokale-prompt-parity-check (ADR 0062)…"
node scripts/ai-parity/scan.mjs --check

# Merkstem-attestatie (ADR 0112): GELAAGD, en dat is het hele punt.
#   hard  — de toon-/claimbron (base.ts § TOON/§ FRAMING, compliance-check
#           § De claimlijst) is gewijzigd zonder dat de copy opnieuw naast die
#           bron is gelegd. Daar zit de Wft-relevante schade.
#   zacht — de copy zelf is bewogen: waarschuwing in de output, geen blokkade.
#           Hard maken zou wrijving op élke tekstwijziging zetten; het script
#           bepaalt de laag zelf en gebruikt daarvoor zijn exit-code.
echo "→ Running merkstem-attestatiecheck (ADR 0112)…"
node scripts/merkstem/scan.mjs --check

# Zelfmodificatie (.claude/): een te pushen commit die de eigen agent-/skill-/
# command-definities raakt MOET een `self-improve:`-onderwerp dragen. De gate
# stond tot nu toe uitsluitend beschreven ín .claude/ en leunde op een
# Notion-property die elke agent zelf mag schrijven — consent-kanaal en
# werk-kanaal waren hetzelfde kanaal. Deze check staat er bewust buiten en toont
# bovendien ongecommitte .claude/-wijzigingen als waarschuwing. Detectie op het
# moment van pushen, geen preventie (zie de kop van het script).
echo "→ Running zelfmodificatie-check (.claude/)…"
node scripts/check-self-modification.mjs

exit 0
