# ============================================================================
# TriFinity — voorbeeld-omgevingsvariabelen
# ----------------------------------------------------------------------------
# Kopieer dit bestand naar `.env.local` en vul de waarden in:
#   cp env.example .env.local
#
# Vul UITSLUITEND placeholders in dit bestand — nooit echte sleutels committen.
# `.env.local` staat in .gitignore en blijft lokaal.
#
# Canonieke bron van deze lijst = de codebase zelf. Nieuwe var toegevoegd?
# Terugvinden met:  grep -rE "process\.env\.[A-Z_]+" app lib
#
# [R] = vereist   ·   [O] = optioneel (heeft fallback of graceful-degradatie)
# NB: platform-vars (NODE_ENV, VERCEL_ENV, VERCEL_GIT_COMMIT_SHA, NEXT_RUNTIME)
#     worden automatisch gezet en horen NIET hier.
# ============================================================================


# ── Supabase (database + auth) ──────────────────────────────────────────────
# Uit je Supabase-project: Project Settings → API.
# De service-role-sleutel is SERVER-ONLY (nooit NEXT_PUBLIC_, nooit in de browser).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co          # [R]
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-public-jwt>                     # [R]
SUPABASE_SERVICE_ROLE_KEY=<service-role-jwt>                        # [R, server-only]


# ── AI-providers (lib/ai/config.ts) ─────────────────────────────────────────
# Standaardprovider is Anthropic. AI_PROVIDER schakelt de actieve provider;
# alleen de sleutel van de gekozen provider is nodig.
AI_PROVIDER=anthropic                                              # [O] anthropic|openai|mistral|ollama
ANTHROPIC_API_KEY=sk-ant-...                                       # [R voor AI]
OPENAI_API_KEY=sk-...                                              # [O]
MISTRAL_API_KEY=...                                               # [O]
OLLAMA_BASE_URL=http://localhost:11434                            # [O]


# ── E-mail (Resend, lib/email.ts) ───────────────────────────────────────────
# Voor uitgaande mail (huishouden-invites, weekbriefing). Zonder RESEND_API_KEY
# wordt mail stil overgeslagen (skipped), niet gecrasht.
RESEND_API_KEY=re_...                                             # [R voor mail]
EMAIL_FROM=TriFinity <noreply@trifinity.app>                     # [O, fallback = deze waarde]


# ── Cron & secrets ──────────────────────────────────────────────────────────
# CRON_SECRET beveiligt de cron-endpoints (news-ingest, snapshots, retention,
# holdings/refresh-prices, briefing-mail). In PRODUCTIE verplicht (fail-closed:
# zonder secret weigeren de crons met 500); in dev mag hij leeg blijven.
# Genereer met: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=                                                      # [R in prod]
# HMAC-secret voor de unsubscribe-tokens in de briefing-mail. Valt terug op
# CRON_SECRET wanneer leeg.
EMAIL_UNSUB_SECRET=                                               # [O, fallback = CRON_SECRET]


# ── App-URL ─────────────────────────────────────────────────────────────────
# Basis-URL voor mail-links, deeplinks en OAuth-callbacks. In productie op de
# echte domeinnaam zetten.
NEXT_PUBLIC_APP_URL=http://localhost:3000                         # [R in prod]


# ── Field-encryptie & rate-limit ────────────────────────────────────────────
# lib/crypto/field-encryption.ts versleutelt bank-tokens + IBANs. Beide sleutels
# MOETEN 32 random bytes hex zijn én van elkaar verschillen.
# Genereer elk met: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# LET OP: verlies in productie = permanent verlies van alle versleutelde
# bank-credentials — bewaar ze in een password manager vóór deploy.
ENCRYPTION_KEY_V1=<hex32>                                         # [R]
IBAN_INDEX_KEY_V1=<hex32>                                         # [R, moet != ENCRYPTION_KEY_V1]
# Stabiele salt voor het hashen van bezoeker-IP's (lib/security/ip-rate-limit.ts).
IP_HASH_SALT=<hex32>                                              # [O, fallback = ENCRYPTION_KEY_V1]


# ── Turnstile / CAPTCHA — publieke lead-gen-funnel /check (ADR 0022) ─────────
# Één keypaar van Cloudflare Turnstile (site- en secret-key horen bij elkaar).
# Maak aan op https://dash.cloudflare.com/?to=/:account/turnstile
# In DEV werkt de funnel door zonder deze keys; in PRODUCTIE weigert
# /api/check/submit zonder geldige Turnstile (fail-closed).
TURNSTILE_SECRET_KEY=0x...                                        # [R voor funnel in prod]
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x...                              # [R voor funnel in prod]


# ── Markt- & holdings-integraties (allemaal optioneel, graceful fallback) ────
# Ontbreken = de betreffende functie valt terug op handmatige invoer / cache.
FMP_API_KEY=                                                      # [O] Financial Modeling Prep (ISIN/ticker)
COINGECKO_API_KEY=                                                # [O] crypto-koersen
BLOCKCHAIR_API_KEY=                                               # [O] on-chain saldi
NIBUD_API_KEY=                                                    # [O] Nibud-budgetnormen


# ── Ops-alerts (lib/cron-alert.ts) ──────────────────────────────────────────
# Ontvanger van operationele waarschuwingen (cron-fouten). Optioneel.
ALERT_EMAIL=ops@trifinity.nl                                      # [O]
OPS_EMAIL=ops@trifinity.nl                                        # [O, alternatief voor ALERT_EMAIL]


# ── Tests / E2E (alleen lokaal, optioneel) ──────────────────────────────────
# Inloggegevens van een testaccount voor de regressie-runner en Playwright-e2e.
REGRESSION_TEST_EMAIL=                                            # [O, alleen voor tests]
REGRESSION_TEST_PASSWORD=                                         # [O, alleen voor tests]


# ── Herstelproef (scripts/herstelproef-check.mjs, alleen lokaal) ────────────
# Wijzen naar de APARTE herstelomgeving waarin een teruggezette back-up wordt
# geteld en gehasht — nooit naar productie. Draait via `npm run herstelproef:check`
# met --env-file=.env.local; hoort NIET in de productie-omgeving te staan.
HERSTELPROEF_SUPABASE_URL=https://<herstel-project-ref>.supabase.co  # [O, alleen lokaal]
HERSTELPROEF_SERVICE_ROLE_KEY=<service-role-jwt-herstelomgeving>     # [O, alleen lokaal, server-only]


# ── Payments (Polar) — NOG NIET ACTIEF ──────────────────────────────────────
# Gereserveerd voor de toekomstige Polar-checkout (lib/subscription-catalog.ts
# staat op available:false tot Polar live gaat). Nog niet in code bedraad —
# laat leeg tot de betaalintegratie geactiveerd wordt.
# POLAR_ACCESS_TOKEN=polar_
# POLAR_WEBHOOK_SECRET=polar_
