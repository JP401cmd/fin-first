# Database
POSTGRES_URL=postgresql://dev_user:dev_password@localhost:5432/postgres_dev

# Cron-beveiliging — vereist voor de cron-endpoints (news-ingest, snapshots,
# holdings/refresh-prices). Vercel Cron stuurt automatisch
# "Authorization: Bearer $CRON_SECRET" mee wanneer deze env-var gezet is.
# In PRODUCTIE verplicht (fail-closed: zonder secret weigeren de crons met 500);
# in dev mag hij leeg blijven. Genereer met:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# Optional - for vector search only
OPENAI_EMBEDDING_MODEL="text-embedding-3-large"

# App URL (for production deployments)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# File storage (optional - if app required file uploads)
BLOB_READ_WRITE_TOKEN=

# Polar payment processing
# Get these from: https://sandbox.polar.sh/dashboard (sandbox) or https://polar.sh/dashboard (production)
POLAR_WEBHOOK_SECRET=polar_
POLAR_ACCESS_TOKEN=polar_

# Field-level encryption (lib/crypto/field-encryption.ts)
# Used to encrypt TrueLayer tokens + IBANs in bank_connections / bank_accounts /
# bank_connection_accounts / assets. Both keys MUST be 32 random bytes hex-encoded
# and MUST be different from each other. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing these in production = permanent loss of all encrypted bank credentials,
# so back them up in a password manager (1Password / Bitwarden) before deploy.
ENCRYPTION_KEY_V1=
IBAN_INDEX_KEY_V1=

# Financial Modeling Prep — ISIN/ticker resolver (lib/integrations/fmp-client.ts)
# Free tier: 250 calls/day. Sign up at https://site.financialmodelingprep.com/
# Optional — when absent, the holdings form falls back to manual ticker entry
# and the koppelingen page shows "Niet geconfigureerd".
FMP_API_KEY=

# Vrijheidscheck — publieke lead-gen-funnel (/check) — ADR 0022
# ── Voor een WERKENDE funnel in PRODUCTIE zijn 5 env-vars nodig: ──────────────
#   1. TURNSTILE_SECRET_KEY            (hieronder) — CAPTCHA, server-side verify
#   2. NEXT_PUBLIC_TURNSTILE_SITE_KEY  (hieronder) — CAPTCHA, client-widget
#   3. ENCRYPTION_KEY_V1               (zie boven) — intake AES-256-GCM-versleuteld opslaan
#   4. IBAN_INDEX_KEY_V1               (zie boven) — HMAC blind-index voor e-mail-dedupe
#   5. IP_HASH_SALT                    (hieronder) — IP-rate-limit hashing
# (#3 + #4 zijn dezelfde sleutels als bij "Field-level encryption" hierboven —
#  de funnel hergebruikt ze; niet apart opnieuw zetten.)
# Faalgedrag bij ontbreken:
#   - Turnstile-paar mist/mismatcht  → HTTP 422 (verificatie mislukt)
#   - ENCRYPTION_KEY_V1 of IBAN_INDEX_KEY_V1 mist → HTTP 503 (weigert plain opslag)
#   - IP_HASH_SALT mist              → valt terug op ENCRYPTION_KEY_V1 (geen fout)
# Na het zetten: REDEPLOY (Vercel past env pas toe bij een nieuwe deploy).
#
# Cloudflare Turnstile (CAPTCHA) op het publieke schrijfpad /api/check/submit.
# Maak een (gratis) widget aan op https://dash.cloudflare.com/?to=/:account/turnstile
# Je krijgt één KEYPAAR — site- en secret-key MOETEN bij elkaar horen (mismatch = 422).
# - TURNSTILE_SECRET_KEY:           server-only siteverify-sleutel (geheim).
# - NEXT_PUBLIC_TURNSTILE_SITE_KEY: publieke widget-sitekey voor de browser.
# Zonder deze keys werkt de funnel in DEV door (CAPTCHA wordt overgeslagen); in
# PRODUCTIE weigert /api/check/submit zonder geldige Turnstile (fail-closed).
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Stabiele salt voor het hashen van bezoeker-IP's in de IP-rate-limit
# (lib/security/ip-rate-limit.ts). Optioneel: valt terug op ENCRYPTION_KEY_V1.
# Genereer met: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=